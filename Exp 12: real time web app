script.js
let students = JSON.parse(localStorage.getItem("students")) || [];

// Display live date and time
function updateClock() {
    let now = new Date();

    $("#datetime").text(now.toLocaleString());
}

setInterval(updateClock, 1000);

updateClock();


// Save records in LocalStorage
function saveData() {
    localStorage.setItem("students", JSON.stringify(students));
}


// Display student records using DOM
function displayStudents() {

    let output = "";

    students.forEach((student, index) => {

        output += `
            <tr>
                <td>${student.name}</td>
                <td>${student.branch}</td>

                <td>
                    <button class="attendance" data-index="${index}">
                        ${student.attendance}
                    </button>
                </td>

                <td>
                    <button class="delete" data-index="${index}">
                        Delete
                    </button>
                </td>
            </tr>
        `;
    });

    $("#studentList").html(output);
}


// Add student using jQuery event
$("#addBtn").click(function() {

    let name = $("#name").val().trim();
    let branch = $("#branch").val().trim();

    if (name === "" || branch === "") {
        $("#message").text("Please enter all details.");
        return;
    }

    students.push({
        name: name,
        branch: branch,
        attendance: "Absent"
    });

    saveData();
    displayStudents();

    $("#name").val("");
    $("#branch").val("");

    $("#message").text("Student added successfully!");
});


// Delete student using event delegation
$("#studentList").on("click", ".delete", function() {

    let index = $(this).data("index");

    students.splice(index, 1);

    saveData();
    displayStudents();

    $("#message").text("Student deleted successfully!");
});


// Mark attendance
$("#studentList").on("click", ".attendance", function() {

    let index = $(this).data("index");

    students[index].attendance =
        students[index].attendance === "Present"
        ? "Absent"
        : "Present";

    saveData();
    displayStudents();
});


// Search student records
$("#search").on("input", function() {

    let value = $(this).val().toLowerCase();

    $("#studentList tr").each(function() {

        let text = $(this).text().toLowerCase();

        $(this).toggle(text.includes(value));
    });
});


// Load JSON data using AJAX
$("#ajaxBtn").click(function() {

    $.getJSON("students.json", function(data) {

        data.forEach(student => {

            students.push({
                name: student.name,
                branch: student.branch,
                attendance: "Absent"
            });

        });

        saveData();
        displayStudents();

        $("#message").text("JSON data loaded successfully!");

    }).fail(function() {

        $("#message").text("Unable to load JSON data.");

    });
});


// Display saved records when page loads
displayStudents();
