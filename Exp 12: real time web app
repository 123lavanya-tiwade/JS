<!DOCTYPE html>
<html>
<head>
    <title>Live Student Dashboard</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>

    <div class="container">

        <h1>Student Dashboard</h1>

        <div class="clock">
            <h3 id="datetime"></h3>
        </div>

        <div class="form">
            <h2>Add Student</h2>

            <input type="text" id="name" placeholder="Enter student name">
            <input type="text" id="branch" placeholder="Enter branch">

            <button id="addBtn">Add Student</button>
            <button id="ajaxBtn">Load JSON Data</button>
        </div>

        <input type="text" id="search" placeholder="Search students...">

        <h2>Student Records</h2>

        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Attendance</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="studentList"></tbody>
        </table>

        <p id="message"></p>

    </div>

    <script src="script.js"></script>

</body>
</html>

