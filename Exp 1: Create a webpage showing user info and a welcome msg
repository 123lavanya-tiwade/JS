index.html

<!DOCTYPE html>
<html>
<head>
    <title>User Information</title>
    <link rel="stylesheet" href="style.css">

    <!-- Internal JavaScript -->
    <script>
        function showMessage() {
            console.log("Welcome to JavaScript Experiment!");
            console.log("Internal JavaScript is working.");
        }
    </script>
</head>

<body onload="showMessage()">

    <div class="container">
        <h1>Welcome to My Webpage!</h1>
        <p class="subtitle">User Information System</p>

        <div class="info">
            <h2>User Details</h2>

            <p><b>Name:</b> Lavanya</p>
            <p><b>Course:</b> B.Tech CSE</p>
            <p><b>College:</b> Symbiosis Institute of Technology</p>
            <p><b>City:</b> Nagpur</p>
        </div>

        <button onclick="welcomeUser()">
            Click for Welcome Message
        </button>

        <h3 id="message"></h3>
    </div>

    <!-- External JavaScript -->
    <script src="script.js"></script>

</body>
</html>

style.css

body {
    font-family: Arial, sans-serif;
    background-color: #eaf2f8;
    text-align: center;
    margin: 0;
    padding: 40px;
}

.container {
    background-color: white;
    width: 450px;
    margin: auto;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 10px gray;
}

h1 {
    color: #2c3e50;
}

.subtitle {
    color: gray;
}

.info {
    background-color: #f2f7fc;
    padding: 15px;
    margin: 20px 0;
    border-radius: 10px;
    text-align: left;
}

button {
    background-color: #3498db;
    color: white;
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background-color: #21618c;
}

#message {
    color: green;
}

script.js

function welcomeUser() {
    let name = "Lavanya";

    document.getElementById("message").innerHTML =
        "Hello " + name + "! Welcome to JavaScript.";

    console.log("User Name: " + name);
    console.log("Welcome message displayed successfully!");

    console.info("JavaScript is running successfully.");
    console.warn("This is a warning message.");
    console.error("This is an example error message.");
}
