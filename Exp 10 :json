scriptjs
// Load JSON using Fetch API
function loadUsingFetch() {

    fetch("students.json")
        .then(response => response.json())
        .then(data => {
            displayData(data);
        })
        .catch(error => {
            alert("Error loading JSON data");
            console.log(error);
        });
}


// Load JSON using jQuery getJSON()
function loadUsingJQuery() {

    $.getJSON("students.json", function(data) {
        displayData(data);
    })
    .fail(function() {
        alert("Error loading JSON data");
    });
}


// Display JSON data dynamically in table
function displayData(students) {

    let table = "";

    students.forEach(student => {

        table += `
            <tr>
                <td>${student.id}</td>
                <td>${student.name}</td>
                <td>${student.branch}</td>
                <td>${student.marks}</td>
            </tr>
        `;

    });

    document.getElementById("studentData").innerHTML = table;
}
