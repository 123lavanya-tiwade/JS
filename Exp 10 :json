<!DOCTYPE html>
<html>
<head>
    <title>JSON Data Display</title>
    <link rel="stylesheet" href="style.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>

    <div class="container">
        <h1>Student Records</h1>

        <button onclick="loadUsingFetch()">Load using Fetch()</button>

        <button onclick="loadUsingJQuery()">Load using jQuery getJSON()</button>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Marks</th>
                </tr>
            </thead>

            <tbody id="studentData">
                <tr>
                    <td colspan="4">Click a button to load data</td>
                </tr>
            </tbody>
        </table>
    </div>

    <script src="script.js"></script>
</body>
</html>
