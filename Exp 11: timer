timer.js
export function updateClock() {
    const now = new Date();

    document.getElementById("clock").innerText =
        "Current Time: " + now.toLocaleTimeString();
}

export function startCountdown(targetTime) {

    const now = new Date();
    const difference = targetTime - now;

    if (difference <= 0) {
        return "00:00:00";
    }

    const hours = Math.floor(difference / 3600000);
    const minutes = Math.floor((difference % 3600000) / 60000);
    const seconds = Math.floor((difference % 60000) / 1000);

    return (
        String(hours).padStart(2, "0") + ":" +
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0")
    );
}

export function showMessage() {
    document.getElementById("status").innerText =
        "Your class is starting soon!";
}

script.js
import { updateClock, startCountdown, showMessage } from "./timer.js";

let interval;
let timeout;

const subject = "Web Technology";

let classTime = new Date();
classTime.setHours(23, 59, 59, 0);

document.getElementById("subject").innerText = subject;

document.getElementById("time").innerText =
    "Class Time: " + classTime.toLocaleTimeString();

function startScheduler() {

    clearInterval(interval);
    clearTimeout(timeout);

    document.getElementById("status").innerText =
        "Waiting for class...";

    function update() {
        updateClock();

        const remaining = startCountdown(classTime);

        document.getElementById("countdown").innerText = remaining;

        if (classTime - new Date() <= 0) {
            clearInterval(interval);

            document.getElementById("countdown").innerText =
                "00:00:00";

            document.getElementById("status").innerText =
                "Class is now in progress!";
        }
    }

    update();

    interval = setInterval(update, 1000);

    timeout = setTimeout(() => {
        showMessage();
    }, Math.max(0, classTime - new Date() - 60000));
}

function stopScheduler() {
    clearInterval(interval);
    clearTimeout(timeout);

    document.getElementById("status").innerText =
        "Scheduler stopped.";

    document.getElementById("countdown").innerText =
        "Stopped";
}

document.getElementById("startBtn").addEventListener("click", startScheduler);
document.getElementById("stopBtn").addEventListener("click", stopScheduler);

updateClock();
