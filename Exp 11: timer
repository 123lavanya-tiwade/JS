<!DOCTYPE html>
<html>
<head>
    <title>Dynamic Class Scheduler</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>Class Scheduler</h1>
        <p id="clock">Current Time: --:--:--</p>

        <div class="card">
            <h2>Upcoming Class</h2>
            <h3 id="subject">Web Technology</h3>
            <p id="time">Class Time: 09:00 AM</p>

            <div id="countdown">Loading countdown...</div>

            <p id="status">Waiting for class...</p>
        </div>

        <button id="startBtn">Start Scheduler</button>
        <button id="stopBtn">Stop Scheduler</button>

        <p class="note">Countdown updates automatically every second.</p>
    </div>

    <script type="module" src="script.js"></script>
</body>
</html>

