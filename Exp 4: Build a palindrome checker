script.js

// Function Declaration
function createPalindromeChecker() {

    // Closure and Outer Scope
    let count = 0;

    // Function Expression
    const check = function(input) {

        // Local Scope
        try {

            if (input.trim() === "") {
                throw new Error("Please enter a word or number!");
            }

            count++;

            // Arrow Function
            const reverse = (str) =>
                str.split("").reverse().join("");

            let original = input.toLowerCase();
            let reversed = reverse(original);

            if (original === reversed) {
                return `Yes! ${input} is a Palindrome.
                        Total Checks: ${count}`;
            }
            else {
                return `No! ${input} is not a Palindrome.
                        Total Checks: ${count}`;
            }

        }
        catch (error) {
            return error.message;
        }
    };

    return check;
}

// Closure Function
const palindrome = createPalindromeChecker();

// Main Function
function checkPalindrome() {

    let input = document.getElementById("userInput").value;

    let result = palindrome(input);

    document.getElementById("result").innerHTML = result;
}
